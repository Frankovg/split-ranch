{
  "name": "split-ranch",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "domain:test": "pnpm --filter @split-ranch/domain test",
    "mobile:dev": "node scripts/mobile-dev.mjs",
    "adb:reverse": "node scripts/adb-reverse.mjs",
    "api:test": "cd apps/api && uv run pytest",
    "api:dev": "cd apps/api && uv run uvicorn split_ranch.main:app --reload --port 8000",
    "db:up": "supabase start",
    "db:down": "supabase stop"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2"
  }
}
