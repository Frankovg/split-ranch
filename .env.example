# Copy to .env (git-ignored). Values below target the local Supabase CLI stack.

# API (in the cloud: Supabase transaction pooler, port 6543)
DATABASE_URL=postgresql+psycopg://split_api:split_api@localhost:54322/postgres
# Worker + migrations (in the cloud: session pooler port 5432 or direct; needs LISTEN/NOTIFY)
DATABASE_URL_SESSION=postgresql+psycopg://split_api:split_api@localhost:54322/postgres
SUPABASE_URL=http://localhost:54321
SUPABASE_JWT_ISSUER=http://localhost:54321/auth/v1
# Worker only (account deletion). Never ship to the app.
SUPABASE_SECRET_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_SHARED_DRIVE_ID=
SENTRY_DSN=
APP_ENV=dev

# Read by supabase/config.toml for the local Google provider
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Mobile (EXPO_PUBLIC_* values are bundled into the app: never put secrets here)
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_SENTRY_DSN=
