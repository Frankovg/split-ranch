    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/select": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/switch": "^1.5.2",
    "@rn-primitives/tabs": "^1.5.2",
    "@rn-primitives/toggle": "^1.5.2",
    "@rn-primitives/toggle-group": "^1.5.2",
    "@sentry/react-native": "~8.37.0",
    "@split-ranch/api-client": "workspace:*",
    "@split-ranch/domain": "workspace:*",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/query-async-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "^58.1.0",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.9",
    "expo-dev-client": "~58.0.22",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.10",
    "expo-router": "~58.0.33",
