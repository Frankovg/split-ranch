{
  "name": "@split-ranch/mobile",
  "version": "0.1.5",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "doctor": "expo-doctor",
    "export:android": "expo export --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "update:preview": "eas update --channel preview --environment production --platform android && pnpm sentry:sourcemaps",
    "sentry:sourcemaps": "eas env:exec production --non-interactive \"pnpm exec sentry-expo-upload-sourcemaps dist\"",
    "fingerprint": "eas fingerprint:compare --environment production",
    "lint": "eslint ."
  },
  "dependencies": {
    "@expo-google-fonts/readex-pro": "^0.4.1",
    "@hookform/resolvers": "^7.0.3",
    "@react-native-community/datetimepicker": "9.2.1",
