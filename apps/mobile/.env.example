# Copy to apps/mobile/.env.local. EXPO_PUBLIC_* values are bundled into the app: never put secrets here.
# All are optional: without them the app runs signed out (Quick splits work fully offline).
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
