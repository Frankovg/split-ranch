{
  "name": "@split-ranch/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts --root-types --root-types-no-schema-prefix --default-non-nullable false",
    "check": "openapi-typescript openapi.json -o src/schema.d.ts --root-types --root-types-no-schema-prefix --default-non-nullable false --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.0"
  }
}
